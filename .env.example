# Copy to .env and fill in real values. Do not commit .env.
# Postgres connection string consumed by Prisma (prisma7.config.ts) and the
# signup system-of-record. `prisma migrate deploy` applies prisma/migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Where the beta path 303-redirects after the signup commits. Stubbed until #6
# serves it from Sanity; the handler falls back to a placeholder if unset.
TESTFLIGHT_URL="https://testflight.apple.com/join/STUB"
