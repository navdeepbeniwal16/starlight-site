# Copy to .env and fill in real values. Do not commit .env.

# Pooled Postgres connection for the runtime (serverless functions). On Neon this
# is the -pooler host. Locally, point it straight at your Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Direct (unpooled) Postgres connection for migrations — DDL can't run through a
# pooler. On Neon this is the non-pooler host. Leave unset locally/in CI and
# migrations fall back to DATABASE_URL. On Vercel, the Neon integration injects this
# as DATABASE_URL_UNPOOLED, so you don't set DIRECT_URL there.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Beta path redirects here after a signup commits. Sanity siteSettings.testFlightUrl
# is the source of truth; this env var is the fallback used when Sanity isn't
# configured (local/CI).
TESTFLIGHT_URL="https://testflight.apple.com/join/STUB"

# Sanity CMS — the landing-page content model + Studio (served at /studio). Leave the
# project id unset locally/in CI and the site falls back to the static copy in
# src/lib/site.ts (and /studio shows a "not configured" notice); nothing reaches
# Sanity. Set both in production (the dataset is the single `production` dataset).
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
# Optional; pins the query API version. Defaults to the date in src/sanity/env.ts.
NEXT_PUBLIC_SANITY_API_VERSION=""

# Shared secret for the publish webhook (POST /api/revalidate). Set the same value
# here and in the Sanity webhook config so a publish revalidates the live page.
# Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=""

# Secret that signs each form's render timestamp for the signup bot trap (honeypot +
# time-trap). Any high-entropy string; must be set for the signup route to accept a
# submission. Keep it stable across instances so a token signed by one verifies on
# another. Generate with: openssl rand -hex 32
SIGNUP_FORM_SECRET=""

# HubSpot CRM sync. Leave HUBSPOT_ACCESS_TOKEN unset (local/CI) to use the no-op
# client — nothing reaches HubSpot. Set all three in production: a private-app token
# plus the list id each signup path upserts into.
HUBSPOT_ACCESS_TOKEN=""
HUBSPOT_LAUNCH_WAITLIST_LIST_ID=""
HUBSPOT_BETA_TESTER_LIST_ID=""

# Soft retry cap for the reconciliation sweep (defaults to 5): a row that fails this
# many times is left for manual inspection instead of being retried forever.
HUBSPOT_SYNC_MAX_ATTEMPTS="5"

# Bearer token protecting the cron sweep (/api/cron/sync) and manual /api/resync.
# Vercel injects it on cron invocations; set it in the Vercel project env vars.
CRON_SECRET=""
