// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // No `url` here on purpose: the driver adapter supplies the pooled runtime
  // connection and prisma7.config.ts supplies the direct one for migrations.
}

enum Segment {
  launch_waitlist
  beta_tester
}

model Signup {
  id           String    @id @default(uuid())
  email        String
  segment      Segment
  createdAt    DateTime  @default(now()) @map("created_at")
  source       String?
  consentAt    DateTime? @map("consent_at")
  syncedAt     DateTime? @map("synced_at")
  syncAttempts Int       @default(0) @map("sync_attempts")
  // First-touch UTM, captured client-side and posted with the form. Nullable: direct
  // traffic and pre-analytics rows carry none.
  utmSource    String?   @map("utm_source")
  utmMedium    String?   @map("utm_medium")
  utmCampaign  String?   @map("utm_campaign")
  utmTerm      String?   @map("utm_term")
  utmContent   String?   @map("utm_content")

  @@unique([email, segment])
  @@map("signup")
}
